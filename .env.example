APP_ENV=development

# LLM (obligatorias)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL_GENERATION=claude-sonnet-5-5
MODEL_FAST=claude-haiku-4-5-20251001

# LLM (opcionales): tiempo máximo por intento y reintentos ante fallas temporales
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Opcionales hasta que se construya el componente que las usa
QDRANT_URL=
QDRANT_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
NOTION_API_KEY=
