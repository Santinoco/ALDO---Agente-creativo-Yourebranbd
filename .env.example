APP_ENV=development

# LLM (obligatorias). LLM_PROVIDER elige el proveedor: gemini o anthropic.
# Solo hace falta la clave del proveedor elegido.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelos del proveedor elegido. Con anthropic, por ejemplo:
# MODEL_GENERATION=claude-sonnet-5-5 y MODEL_FAST=claude-haiku-5-5
MODEL_GENERATION=gemini-3.8-flash
MODEL_FAST=gemini-3.5-flash-lite

# Edición de video (opcional): siempre usa Claude, sin importar LLM_PROVIDER.
# Para habilitarla: MODEL_VIDEO_EDIT=claude-opus-5-5 y ANTHROPIC_API_KEY.
# Vacío = edición de video deshabilitada (la app arranca solo con Gemini).
MODEL_VIDEO_EDIT=
# Preparación del video (opcionales): modelo de Whisper local y fotogramas por plan.
# Requiere ffmpeg instalado y pip install -e ".[video]".
WHISPER_MODEL=small
VIDEO_MAX_FRAMES=40
# Topes de gasto por plan (opcionales). La salida la corta la API; la entrada se
# estima antes de llamar y, si supera el tope, no se llama. Un timeout de esta
# tarea no se reintenta. El tope de verdad en plata es el límite de gasto
# mensual que se configura en la consola de Anthropic.
VIDEO_EDIT_MAX_OUTPUT_TOKENS=16000
VIDEO_EDIT_MAX_INPUT_TOKENS=60000
VIDEO_EDIT_TIMEOUT_SECONDS=600
VIDEO_EDIT_MAX_CALLS_PER_TURN=2

# LLM (opcionales): tiempo máximo por intento y reintentos ante fallas temporales
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Opcionales hasta que se construya el componente que las usa
QDRANT_URL=
QDRANT_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
NOTION_API_KEY=
