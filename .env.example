APP_ENV=development

# LLM (obligatorias). LLM_PROVIDER elige el proveedor: gemini o anthropic.
# Solo hace falta la clave del proveedor elegido.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelos del proveedor elegido. Con anthropic, por ejemplo:
# MODEL_GENERATION=claude-sonnet-5-5 y MODEL_FAST=claude-haiku-5-5
MODEL_GENERATION=gemini-3.8-flash
MODEL_FAST=gemini-3.5-flash-lite

# LLM (opcionales): tiempo máximo por intento y reintentos ante fallas temporales
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Opcionales hasta que se construya el componente que las usa
QDRANT_URL=
QDRANT_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
NOTION_API_KEY=
